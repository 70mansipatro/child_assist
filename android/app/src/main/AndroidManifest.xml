<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed to call the Child Assist backend API. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Runtime permissions. Each is requested only when the user opens the related feature
         (see lib/core/permissions/permission_service.dart). The microphone is used in the background
         only by the opt-in "Hey Child" wake word, with a persistent notification. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Automatic Location History only. Requested after the user switches it on and reads what is
         collected (Android 10+ asks separately for "Allow all the time"). While it runs, location is
         read by geolocator's foreground service (foregroundServiceType="location", declared in the
         plugin's manifest) with a persistent notification; it stops when the user turns it off or
         logs out. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14+: the type-specific permission for a location foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Tap-to-talk, and the "Hey Child" wake word only after the user switches it on in
         Settings > Voice Assistant. The wake word is detected on the phone (WakeWordService); no
         audio is recorded to storage or sent anywhere. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Android 14+: the type-specific permission for the wake word's microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- After "Hey Child", opens Child Assist over a locked or sleeping screen for the question
         (a full-screen notification). Android 14+ may require the user to allow it in Settings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Optional, granted by the user in Settings ("Display over other apps"): lets "Hey Child" open
         Child Assist while another app is in use (Android blocks background activity starts
         otherwise; a heads-up notification is shown instead). Never used to draw over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Photos: Android 13+ uses READ_MEDIA_IMAGES (plus partial "selected photos" access on 14+);
         Android 12 and below fall back to READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Android 10+: lets the app read the GPS position stored in a photo, only to match photos to
         the user's own saved places when they ask in chat. Without it, matching uses time only. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- Android 13+; older versions allow notifications by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Contacts: read only, searched on the phone when the user asks for a contact in chat.
         The address book is never uploaded. No WRITE_CONTACTS: Child Assist never changes it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Camera and microphone are optional, so devices without them can still install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- allowBackup=false: flutter_secure_storage keys cannot be restored from backup,
         and the stored auth token should not leave the device. -->
    <application
        android:label="child_assist"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- "Hey Child" wake word. Runs only while the user has it switched on, always with a
             persistent notification (with "Turn off"); stops on logout or when the microphone
             permission is removed. Not exported: only this app can start it. -->
        <service
            android:name=".wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone|shortService" />
        <!-- Push notifications (Firebase Cloud Messaging). Pushes that arrive while the app is in
             the background are shown by Android with this icon on this channel unless they name
             one; the app creates the channels (lib/core/notifications/notification_channels.dart). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_child_assist" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="child_assist_general" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+: lets voice chat find the device's speech recognizer (speech_to_text)
             and text-to-speech engine (flutter_tts). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Android 11+: lets chat check whether WhatsApp is installed before opening a prepared
             message in it (the user sends it there), and offer the share sheet otherwise. -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
