# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:<password>@localhost:5432/child_assist?schema=public"

# JWT authentication. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<a-long-random-secret>"
JWT_EXPIRES_IN="7d"

# --- Google Sign-In ("Continue with Google") ---
# The Google OAuth *Web application* client ID (Google Cloud Console > APIs & Services >
# Credentials). Google ID tokens from the app must be issued to this audience. It is an ID, not a
# secret; no client secret is needed. Without it POST /api/auth/google answers 503.
GOOGLE_WEB_CLIENT_ID=

# --- Email verification (SMTP) ---
# Password accounts must enter a 6-digit code emailed to them before they can log in. Used only by
# the backend; never put these in the Flutter app or commit real values. Without SMTP_HOST and
# SMTP_FROM, registration and code resends answer 503 (login, Google Sign-In and the rest work).
# The same settings send emails the user asks Child Assist to send in chat, only after they
# confirm them in the app; without SMTP the assistant says email is not set up.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=your
# Gmail address, SMTP_PASSWORD=an App Password (Google Account > Security > App passwords; needs
# 2-Step Verification), SMTP_FROM=Child Assist <your-email@gmail.com>.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS (port 587), which is then required.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Phase 7: Child Assist AI (Google Gemini via Vertex AI) ---
# Used only by the backend; never put these in the Flutter app.
# Authentication uses Google Application Default Credentials: either point
# GOOGLE_APPLICATION_CREDENTIALS at a service-account key file kept OUTSIDE the repo, or run
# `gcloud auth application-default login` on a development machine.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Vertex AI Gemini model IDs. The chat model is required for /api/chat (it answers 503 without it).
CHAT_MODEL=
# Optional: tried when the chat model fails or times out.
CHAT_FALLBACK_MODEL=
# Optional but recommended: a small, fast model that screens messages before any tool runs.
# Without it only the built-in rule-based guardrails apply.
GUARDRAIL_MODEL=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\service-account.json

# --- Automatic Location History ---
# No API key is needed: the phone's own GPS and geocoder are used. These only tune how the server
# treats automatic uploads; all are optional (defaults shown).
# An automatic point within this distance AND this time of an existing one is a duplicate.
# AUTO_LOCATION_MIN_DISTANCE_METERS=100
# AUTO_LOCATION_MIN_INTERVAL_SECONDS=300
# Automatic points older than this many days are refused (stale offline queue).
# AUTO_LOCATION_MAX_AGE_DAYS=7
# POST /api/location requests allowed per user per window (manual and automatic together).
# LOCATION_RATE_LIMIT_MAX=120
# LOCATION_RATE_LIMIT_WINDOW_SECONDS=600

# --- Chat memory ---
# Most recent messages sent to Gemini word for word; older ones are folded into a short
# server-side summary every CHAT_SUMMARY_BATCH messages. Optional (defaults shown).
# CHAT_HISTORY_MESSAGE_LIMIT=30
# CHAT_SUMMARY_BATCH=10
