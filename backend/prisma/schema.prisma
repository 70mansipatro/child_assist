// Prisma schema for Child Assist.
// Connection URL is configured in prisma.config.ts (reads DATABASE_URL from .env).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String   @id @default(uuid()) @db.Uuid
  email                         String   @unique
  name                          String?
  // Null for accounts created with "Continue with Google".
  passwordHash                  String?  @map("password_hash")
  // Google's stable account ID (the verified ID token's `sub`), for accounts that sign in with
  // Google. Never the email, and no Google tokens are stored.
  googleSubject                 String?  @unique @map("google_subject")
  // Password accounts must prove they own the address (6-digit emailed code) before they can log
  // in. Google accounts are verified by Google, and accounts created before verification existed
  // were marked verified by the email_verification migration.
  emailVerified                 Boolean  @default(false) @map("email_verified")
  // Reference to an externally hosted image only; image bytes are never stored in the database.
  profileImageUrl               String?  @map("profile_image_url")
  // Whether the user has been through the first-time permission walkthrough once. Separate from
  // the per-permission statuses in user_permissions: a completed user may still have denials.
  permissionOnboardingCompleted Boolean  @default(false) @map("permission_onboarding_completed")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  permissions       UserPermission[]
  locations         LocationHistory[]
  chatConversations ChatConversation[]
  chatToolCalls     ChatToolCall[]
  chatActions       ChatAction[]
  documentReads     DocumentReadRequest[]
  photoReferences   PhotoReference[]
  photoRequests     PhotoRequest[]

  emailVerificationCodes EmailVerificationCode[]
  passwordResetCodes     PasswordResetCode[]

  notificationDevices    NotificationDevice[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@map("users")
}

// One-time codes emailed for "Forgot password", kept apart from email verification: a code for one
// purpose never works for the other. Only an HMAC of the code is stored. A correct code is not a
// password change by itself: it sets verifiedAt and a short-lived reset token (stored only as a
// SHA-256 hash) that POST /api/auth/reset-password spends. consumedAt marks the row dead: after the
// password changes, or when a newer code replaces it. Also dead once expired or after 5 wrong tries.
model PasswordResetCode {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id") @db.Uuid
  codeHash            String    @map("code_hash") @db.VarChar(64)
  expiresAt           DateTime  @map("expires_at")
  attempts            Int       @default(0)
  verifiedAt          DateTime? @map("verified_at")
  resetTokenHash      String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// One-time codes emailed to verify a password account's address. Only an HMAC of the code is
// stored, never the code. A code is spent when consumedAt is set: on successful verification, or
// when a newer code replaces it. It is also dead once expired or after 5 wrong attempts.
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

enum PermissionType {
  LOCATION
  MICROPHONE
  CAMERA
  PHOTOS
  NOTIFICATIONS
  DOCUMENTS
  // Phone contacts. Searched only on the device; the address book never reaches the server.
  CONTACTS
}

enum PermissionStatus {
  UNKNOWN
  GRANTED
  DENIED
  RESTRICTED
  LIMITED
}

// The user's last reported device permission status, synced from the app for display/audit.
// The OS remains the source of truth: this record never grants anything on the device.
model UserPermission {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  permission PermissionType
  status     PermissionStatus @default(UNKNOWN)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

// How a saved location was collected.
enum LocationSource {
  // The user tapped "Get Current Location".
  MANUAL
  // Saved by Automatic Location History, which the user switched on and the OS allowed
  // (background location, with a visible notification on Android). Only significant places,
  // never a continuous track.
  AUTOMATIC
}

// A device location saved for the user, either on request or by Automatic Location History.
// No device identifiers. The place fields come from the device's own reverse geocoder and may
// all be null.
model LocationHistory {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  // Rows saved before automatic history existed were all manual, hence the default.
  source     LocationSource @default(MANUAL)
  latitude   Decimal        @db.Decimal(10, 7)
  longitude  Decimal        @db.Decimal(10, 7)
  // Horizontal accuracy radius in metres, if the device reported one.
  accuracy   Decimal?       @db.Decimal(10, 2)
  placeName  String?        @map("place_name") @db.VarChar(255)
  address    String?        @db.VarChar(1000)
  street     String?        @db.VarChar(255)
  locality   String?        @db.VarChar(255)
  city       String?        @db.VarChar(255)
  state      String?        @db.VarChar(255)
  postalCode String?        @map("postal_code") @db.VarChar(32)
  country    String?        @db.VarChar(255)
  // When the device took the reading (client clock); createdAt is when the server stored it.
  capturedAt DateTime       @map("captured_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([userId, source, capturedAt])
  @@map("location_history")
}

// Phase 7: conversations with the "Child Assist" AI assistant. Every row is owned by exactly
// one user, which callers must take from the verified JWT, never from the request body.

enum ChatMessageRole {
  CHAT_USER
  CHAT_ASSISTANT
  CHAT_SYSTEM
  CHAT_TOOL
}

model ChatConversation {
  id              String    @id @default(cuid())
  userId          String    @map("user_id") @db.Uuid
  title           String?   @db.VarChar(255)
  // Server-only memory for long chats: a short summary of the messages up to and including
  // summarizedUntil, so the model keeps their context without receiving every message. Written by
  // the backend (secrets redacted, no places or coordinates) and never returned to the app.
  summary         String?   @db.Text
  summarizedUntil DateTime? @map("summarized_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
  toolCalls       ChatToolCall[]
  actions         ChatAction[]
  documentReads   DocumentReadRequest[]
  photoReferences PhotoReference[]
  photoRequests   PhotoRequest[]

  @@index([userId])
  @@index([updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String          @map("conversation_id")
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

// Audit record that the assistant invoked a tool. Deliberately holds no arguments or results:
// tool payloads may contain locations, contacts, photos, documents or credentials.
model ChatToolCall {
  id                   String   @id @default(cuid())
  conversationId       String   @map("conversation_id")
  userId               String   @map("user_id") @db.Uuid
  toolName             String   @map("tool_name") @db.VarChar(100)
  status               String   @db.VarChar(32)
  confirmationRequired Boolean  @default(false) @map("confirmation_required")
  confirmed            Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_tool_calls")
}

// Side-effect actions the assistant prepared (an email, a WhatsApp message) that only run after the
// user explicitly confirms them in the app. The id is shared with the ChatToolCall audit row.
// Recipient and content are kept only for the short confirmation lifecycle: they are cleared as
// soon as the action reaches a final status. The phone's address book is never stored: only the
// one address the user picked for this action.

enum ChatActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
  EXPIRED
}

enum ChatActionType {
  SEND_EMAIL
  SEND_WHATSAPP
  SHARE_LOCATION
  SHARE_TRAVEL_HISTORY
  SHARE_DOCUMENT
  // Another contact's phone number, looked up and picked on the phone ("send A's number to B").
  SHARE_CONTACT
  // One photo from the user's phone gallery, found in this conversation (PhotoReference).
  SHARE_PHOTO
}

// How the action reaches the recipient. EMAIL is sent by the backend over SMTP; WHATSAPP is opened
// on the phone with the message prefilled and the user sends it there.
enum ChatActionChannel {
  EMAIL
  WHATSAPP
}

model ChatAction {
  id                 String            @id
  userId             String            @map("user_id") @db.Uuid
  conversationId     String            @map("conversation_id")
  type               ChatActionType
  channel            ChatActionChannel
  status             ChatActionStatus  @default(PENDING)
  // The contact name the user said ("Mansi"), resolved on the phone when no address was given.
  contactQuery       String?           @map("contact_query") @db.VarChar(120)
  recipientName      String?           @map("recipient_name") @db.VarChar(120)
  // An email address (EMAIL) or phone number (WHATSAPP). Null until the app resolves the contact.
  recipientAddress   String?           @map("recipient_address") @db.VarChar(320)
  subject            String?           @db.VarChar(200)
  message            String?           @db.Text
  // What sensitive data is included, e.g. "Today's travel history (3 saved locations)".
  dataSummary        String?           @map("data_summary") @db.VarChar(300)
  // For SHARE_DOCUMENT: the document name the user mentioned, matched on the phone.
  documentQuery      String?           @map("document_query") @db.VarChar(120)
  // For SHARE_DOCUMENT: the one document the user picked on the phone, set once before Confirm.
  // The id is the app's opaque id for the document in that user's own on-device list, never a path
  // or URI; the phone shares exactly this document after Confirm. The name is shown for
  // confirmation and cleared when the action finishes.
  documentId         String?           @map("document_id") @db.VarChar(64)
  documentName       String?           @map("document_name") @db.VarChar(255)
  documentType       String?           @map("document_type") @db.VarChar(8) // For SHARE_CONTACT: the contact whose number is shared, kept apart from the recipient. The name
  // the user said is resolved on the phone; the picked name and number then build the message.
  sharedContactQuery String?           @map("shared_contact_query") @db.VarChar(120)
  sharedContactName  String?           @map("shared_contact_name") @db.VarChar(120)
  sharedContactPhone String?           @map("shared_contact_phone") @db.VarChar(32)
  // For SHARE_PHOTO: the server's opaque id of the photo (a PhotoReference of this user), set when
  // the action is prepared. Never a path, URI or device id: the phone resolves it locally.
  photoId            String?           @map("photo_id") @db.VarChar(40)
  expiresAt          DateTime          @map("expires_at")
  confirmedAt        DateTime?         @map("confirmed_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("chat_actions")
}

// Phase 9: notifications. Firebase Cloud Messaging only delivers them; accounts, history and
// preferences live here. Every row is owned by one user, taken from the verified JWT.

// Every kind of notification Child Assist sends. Each maps to one preference category in
// backend/src/modules/notifications/notification.types.ts.
enum NotificationType {
  ACCOUNT_LOGIN
  ACCOUNT_SECURITY
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGED
  PERMISSION_CHANGED
  TRACKING_STARTED
  TRACKING_STOPPED
  TRACKING_PAUSED
  LOCATION_UPDATED
  TRAVEL_HISTORY_UPDATED
  CHAT_REPLY_READY
  EMAIL_ACTION
  WHATSAPP_ACTION
  DOCUMENT_UPDATED
  PHOTO_UPDATED
  SYSTEM
  GENERAL
}

enum DevicePlatform {
  ANDROID
  IOS
}

// A phone that receives push notifications for the signed-in user. The FCM registration token
// is unique: when another account signs in on the same phone the row moves to that account, so
// one phone never receives two accounts' notifications. Deleted on logout and when FCM reports
// the token as invalid. No hardware identifiers are stored.
model NotificationDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique @db.VarChar(4096)
  platform   DevicePlatform
  appVersion String?        @map("app_version") @db.VarChar(40)
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("notification_devices")
}

// The user's notification history. Titles and bodies are fixed product copy: never coordinates,
// addresses, contact details, chat content, codes or tokens. The app loads any details itself,
// authenticated, after the user opens the notification.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(120)
  body         String           @db.VarChar(300)
  // An internal childassist:// route, e.g. childassist://location.
  deepLink     String?          @map("deep_link") @db.VarChar(200)
  // Non-sensitive extras only (e.g. which permission changed).
  metadataJson Json?            @map("metadata_json")
  // One business event creates at most one notification: e.g. "tracking started" is not
  // repeated for every location callback. Unique per user.
  dedupeKey    String?          @map("dedupe_key") @db.VarChar(200)
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
  @@map("notifications")
}

// Which categories the user wants. A missing row means all defaults (everything on). Security
// alerts are always delivered: securityEnabled cannot be switched off.
model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  securityEnabled      Boolean  @default(true) @map("security_enabled")
  accountEnabled       Boolean  @default(true) @map("account_enabled")
  permissionEnabled    Boolean  @default(true) @map("permission_enabled")
  locationEnabled      Boolean  @default(true) @map("location_enabled")
  chatEnabled          Boolean  @default(true) @map("chat_enabled")
  communicationEnabled Boolean  @default(true) @map("communication_enabled")
  systemEnabled        Boolean  @default(true) @map("system_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------------------------
// Reading one of the user's documents for the assistant ("Python notes me kya hai?").
//
// Documents live only on the phone. When the assistant needs one, it opens a short-lived request
// here; the phone finds the document in that user's own list, checks it is still there, extracts
// its text locally and posts the text of that one document to this request. The backend answers
// the question from it and stores only the answer (as a chat message): the document text itself
// is never stored or logged. The question is cleared when the request finishes.

enum DocumentReadStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

model DocumentReadRequest {
  id             String             @id @default(cuid())
  userId         String             @map("user_id") @db.Uuid
  conversationId String             @map("conversation_id")
  status         DocumentReadStatus @default(PENDING)
  // The words the user used for the document ("python notes"); null for "this document".
  documentQuery  String?            @map("document_query") @db.VarChar(120)
  documentType   String?            @map("document_type") @db.VarChar(8)
  // What the user wants to know, in their words. Cleared once the request finishes.
  question       String?            @db.VarChar(500)
  // The app's opaque id of the document that was read (never a path or URI).
  documentId     String?            @map("document_id") @db.VarChar(64)
  expiresAt      DateTime           @map("expires_at")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("document_read_requests")
}

// ---------------------------------------------------------------------------------------------
// Photos in chat ("Show me the photo from where I went today", "What is in this photo?").
//
// Photos live only on the phone. The phone searches its own gallery, and for each photo it shows
// in a conversation the server mints an opaque id (photo_...) and keeps only the metadata below:
// no image bytes, no file name, no path, no content URI and no device asset id. The phone keeps
// the mapping from that id to its own gallery entry. Every row belongs to the user from the JWT.

model PhotoReference {
  id               String    @id @db.VarChar(40)
  userId           String    @map("user_id") @db.Uuid
  conversationId   String    @map("conversation_id")
  capturedAt       DateTime  @map("captured_at")
  width            Int?
  height           Int?
  // The user's own saved place the photo was matched to, and how ("GPS": the photo's own GPS
  // metadata was near it; "TIME": taken close in time to it). Null when not matched to a place.
  placeName        String?   @map("place_name") @db.VarChar(255)
  placeEvidence    String?   @map("place_evidence") @db.VarChar(8)
  // When the user picked it (or it was the only match): the photo now being talked about.
  selectedAt       DateTime? @map("selected_at")
  // The user asked about the photo's content ("show me today's photo and explain it") while
  // several photos were shown: the question waits here, and picking one of them looks at it.
  analysisQuestion String?   @map("analysis_question") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, selectedAt])
  @@map("photo_references")
}

enum PhotoRequestKind {
  // The phone searches its gallery and reports which photos it showed.
  SEARCH
  // The phone sends the ONE photo being talked about for Gemini vision to answer a question.
  ANALYZE
}

enum PhotoRequestStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

// A short-lived request from the assistant to the phone, answered once. The question is cleared
// when it finishes; the image itself is never stored or logged.
model PhotoRequest {
  id             String             @id @default(cuid())
  userId         String             @map("user_id") @db.Uuid
  conversationId String             @map("conversation_id")
  kind           PhotoRequestKind
  status         PhotoRequestStatus @default(PENDING)
  question       String?            @db.VarChar(500)
  // ANALYZE: the PhotoReference to analyse.
  photoId        String?            @map("photo_id") @db.VarChar(40)
  expiresAt      DateTime           @map("expires_at")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("photo_requests")
}
