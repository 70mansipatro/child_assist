{
  "name": "child-assist-backend",
  "version": "1.0.0",
  "description": "Child Assist backend API (Express + TypeScript + Prisma)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "notify:send": "tsx src/scripts/send-notification.ts",
    "fcm:selftest": "tsx src/scripts/fcm-self-test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.102",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "7.0.128",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "10.9.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
